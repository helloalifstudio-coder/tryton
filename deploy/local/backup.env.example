# Root-owned environment file, mode 0600. Never commit production values.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=tryton
PGDATABASE=showroom
PGPASSFILE=/root/.pgpass
# Exact filestore directory for this Tryton database:
TRYTOND_FILESTORE=/var/lib/trytond/filestore/showroom
BACKUP_DIR=/var/backups/tryton
TRYTOND_SERVICE=trytond.service
# age public recipient only. Keep the matching private identity elsewhere.
AGE_RECIPIENT=age1REPLACE_WITH_REAL_RECIPIENT
