# Copy to .env in this directory and replace every example value.
# Never commit the real .env file.

TRYTON_BASE_IMAGE=tryton/tryton:8.0
APP_IMAGE=alif-showroom:8.0-lts
POSTGRES_IMAGE=postgres:16-alpine

DB_NAME=alif_showroom
DB_USER=tryton
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD

TRYTON_ADMIN_EMAIL=owner@example.invalid
TRYTON_ADMIN_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_ADMIN_PASSWORD

# Localhost is safest for a single-PC pilot.
# For multiple LAN counters, set this to the server's private LAN IP
# after configuring the operating-system firewall.
TRYTON_BIND_ADDRESS=127.0.0.1
